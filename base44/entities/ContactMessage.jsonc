{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Sender's full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Sender's email address"
    },
    "message": {
      "type": "string",
      "description": "The message content"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ]
}